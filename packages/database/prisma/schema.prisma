generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Business {
  id             String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  clerkUserId    String   @unique @map("clerk_user_id")
  name           String
  phoneNumber    String?  @map("phone_number")
  whatsappNumber String?  @map("whatsapp_number")
  industry       String?
  city           String?  @default("Lagos")
  systemPrompt   String?  @map("system_prompt")
  businessHours  Json?    @default("{\"mon_fri\": {\"open\": \"09:00\", \"close\": \"19:00\"}, \"sat\": {\"open\": \"10:00\", \"close\": \"20:00\"}, \"sun\": null}") @map("business_hours")
  voiceId               String?  @default("21m00Tcm4TlvDq8ikWAM") @map("voice_id")
  phoneNumberProvider   String   @default("byon") @map("phone_number_provider") // "han_twilio" | "byon"
  phoneNumberSid        String?  @map("phone_number_sid")   // Twilio SID — for management/release
  whatsappProvider      String   @default("byon") @map("whatsapp_provider")     // "byon" only for now
  isActive              Boolean  @default(true) @map("is_active")
  subscriptionCode      String?  @map("subscription_code")    // Paystack subscription code (e.g. SUB_xxx)
  subscriptionStatus    String   @default("none") @map("subscription_status") // "none" | "active" | "payment_failed" | "cancelled"
  plan           String   @default("trial") @map("plan")
  trialEndsAt    DateTime @default(dbgenerated("now() + interval '14 days'")) @map("trial_ends_at")
  monthlyCallCount  Int   @default(0) @map("monthly_call_count")
  callCountResetAt  DateTime @default(dbgenerated("date_trunc('month', now()) + interval '1 month'")) @map("call_count_reset_at")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  customers     Customer[]
  conversations Conversation[]
  aiUsage       AiUsage[]
  faqTemplates  FaqTemplate[]

  @@map("businesses")
}

model Customer {
  id                   String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  businessId           String    @map("business_id") @db.Uuid
  phoneNumber          String    @map("phone_number")
  name                 String?
  languagePreference   String?   @default("en") @map("language_preference")
  usesPidgin           Boolean   @default(false) @map("uses_pidgin")
  totalConversations   Int       @default(0) @map("total_conversations")
  lastSeenAt           DateTime? @map("last_seen_at")
  createdAt            DateTime  @default(now()) @map("created_at")

  business      Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  conversations Conversation[]

  @@unique([businessId, phoneNumber])
  @@map("customers")
}

model Conversation {
  id           String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  businessId   String    @map("business_id") @db.Uuid
  customerId   String    @map("customer_id") @db.Uuid
  channel      String    @default("whatsapp")
  status       String    @default("active")
  summary      String?
  messageCount Int       @default(0) @map("message_count")
  resolvedAt   DateTime? @map("resolved_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  business Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  messages Message[]
  aiUsage  AiUsage[]

  @@map("conversations")
}

model Message {
  id               String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  conversationId   String   @map("conversation_id") @db.Uuid
  role             String
  content          String
  channelMessageId String?  @map("channel_message_id")
  isCached         Boolean  @default(false) @map("is_cached")
  createdAt        DateTime @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@map("messages")
}

model AiUsage {
  id             String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  businessId     String   @map("business_id") @db.Uuid
  conversationId String?  @map("conversation_id") @db.Uuid
  model          String
  inputTokens    Int      @default(0) @map("input_tokens")
  outputTokens   Int      @default(0) @map("output_tokens")
  costUsd        Decimal  @default(0) @map("cost_usd") @db.Decimal(10, 6)
  cacheHit       Boolean  @default(false) @map("cache_hit")
  queryType      String?  @map("query_type")
  faqMatched     Boolean  @default(false) @map("faq_matched")
  createdAt      DateTime @default(now()) @map("created_at")

  business     Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  conversation Conversation? @relation(fields: [conversationId], references: [id])

  @@map("ai_usage")
}

model FaqTemplate {
  id             String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  businessId     String   @map("business_id") @db.Uuid
  triggerPhrases String[] @map("trigger_phrases")
  response       String
  language       String?  @default("en")
  hitCount       Int      @default(0) @map("hit_count")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@map("faq_templates")
}
